{
  "name": "vp",
  "version": "0.0.0",
  "private": true,
  "description": "Calculadora de precio maximo de compra de vivienda (Espana)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vp/web dev",
    "build": "pnpm --filter @vp/web build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "lint": "pnpm -r --no-bail lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @vp/db generate",
    "db:migrate": "pnpm --filter @vp/db migrate",
    "db:studio": "pnpm --filter @vp/db studio",
    "config:check": "pnpm --filter @vp/config check"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.15.3"
  }
}
