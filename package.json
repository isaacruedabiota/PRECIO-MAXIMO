{
  "name": "vp",
  "version": "0.0.0",
  "private": true,
  "description": "Calculadora de precio maximo de compra de vivienda (Espana)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vp/web dev",
    "build": "pnpm --filter @vp/web build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "lint": "eslint .",
    "db:tunnel": "ssh -N -L 55432:localhost:5432 -i ${USERPROFILE:-$HOME}/.ssh/brio_pi isaac@pi-isaac.local",
    "db:generate": "pnpm --filter @vp/db generate",
    "db:migrate": "pnpm --filter @vp/db migrate",
    "db:studio": "pnpm --filter @vp/db studio",
    "config:check": "pnpm --filter @vp/config check",
    "config:seed": "pnpm --filter @vp/config seed",
    "calibrate": "pnpm --filter @vp/scripts calibrate",
    "ingest:antiguedad": "pnpm --filter @vp/scripts ingest:antiguedad",
    "capture:fixture": "pnpm --filter @vp/scripts capture:fixture",
    "ficha": "pnpm --filter @vp/scripts ficha"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
