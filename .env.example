# Copia a .env y ajusta. NUNCA versiones el .env real.

# --- Base de datos ---
# Desarrollo local (docker compose up -d levanta PostGIS en el 55432)
DATABASE_URL="postgres://vp:vp_dev_password@localhost:55432/vp"

# En la Raspberry Pi la cadena real vive en /etc/vp/vp-web.env, no aqui.

# --- Aplicacion ---
NODE_ENV="development"
PORT=3000

# --- Fuentes de datos ---
# Ninguna de las fuentes usadas requiere clave por ahora (Catastro, INE, MITMA,
# CartoCiudad son publicas y anonimas). Si alguna la requiriese, va aqui.
